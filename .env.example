# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (ห้ามขึ้น git)

# MongoDB บนเครื่องตัวเอง:
MONGODB_URI=mongodb://127.0.0.1:27017
# หรือ MongoDB Atlas (ต้องเพิ่ม IP ของเครื่องใน Network Access ด้วย):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# ชื่อฐานข้อมูล (ไม่ใส่ = agri_track)
MONGODB_DB=agri_track

# Atlas SRV ใช้ Google DNS (8.8.8.8) อัตโนมัติเมื่อไม่กำหนดค่านี้
# กำหนดเองได้หากเครือข่ายของคุณบล็อก DNS server ดังกล่าว:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ใช้เซ็นลายเซ็น session ล็อกอิน (จำเป็น) — สุ่มยาว ๆ อย่างน้อย 32 ตัวอักษร เช่น: openssl rand -base64 32
AUTH_SECRET=
