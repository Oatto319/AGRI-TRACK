{
  "name": "agri-track",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:users": "node --env-file=.env.local scripts/seed-users.mjs",
    "import:area": "node --env-file=.env.local scripts/import-area-reports.mjs",
    "migrate:json": "node --env-file=.env.local scripts/migrate-json-to-mongo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.9.0",
    "exceljs": "^4.4.0",
    "mongodb": "^6.10.0",
    "next": "^16.4.3",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
